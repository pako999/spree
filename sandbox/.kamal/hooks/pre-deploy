#!/usr/bin/env bash
# Pre-deploy hook for non-proxy Kamal setup.
#
# We deploy without kamal-proxy (proxy: false), so Kamal cannot do its usual
# zero-downtime container swap. The new container would fail to bind
# 127.0.0.1:3000 while the previous one still owns it. To work around this,
# we stop and remove any running sandbox containers before the new one boots.
#
# Brief downtime (~30s) is acceptable here — Nginx returns 502 during the gap.
set -e

HOST="46.224.5.25"
echo "==> pre-deploy: stopping previous sandbox containers on ${HOST} to free port 3000"

ssh -o StrictHostKeyChecking=no -o LogLevel=ERROR ubuntu@${HOST} \
  'docker ps --filter "label=service=sandbox" --format "{{.Names}}" | xargs -r docker stop -t 30 || true;
   docker ps --all --filter "label=service=sandbox" --format "{{.Names}}" | xargs -r docker rm -f || true' \
  || true

echo "==> pre-deploy: done"
