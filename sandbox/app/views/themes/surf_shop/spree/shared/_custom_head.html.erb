<%# Favicon & icons %>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">
<meta name="theme-color" content="#0F0F1A">
<%# Cart currency — read by add_to_cart GA4 event to avoid hardcoding 'EUR' %>
<meta name="cart-currency" content="<%= current_order&.currency || current_store&.default_currency || 'EUR' %>">

<% if ENV['KLAVIYO_PUBLIC_KEY'].present? %>
<script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=<%= ENV['KLAVIYO_PUBLIC_KEY'] %>"></script>
<script>
  // Pre-check the "accept marketing" checkbox at checkout (default opt-in)
  document.addEventListener('turbo:load', function() {
    var cb = document.querySelector('input[name="order[accept_marketing]"]');
    if (cb && !cb.dataset.userToggled) cb.checked = true;
    if (cb) cb.addEventListener('change', function() { cb.dataset.userToggled = '1'; });
  });

  // Auto-identify the visitor in Klaviyo when they enter an email at checkout.
  // Without this, guest checkouts can't be re-targeted by abandoned cart.
  (function() {
    function identify(email) {
      if (!email || !email.includes('@')) return;
      var k = window.klaviyo = window.klaviyo || [];
      k.push(['identify', { '$email': email }]);
    }
    // On any email input blur (checkout, account, etc.)
    document.addEventListener('blur', function(e) {
      if (e.target && e.target.matches('input[type=email]')) identify(e.target.value);
    }, true);
    // Logged-in user from data attribute (set in body tag if you want)
    var meta = document.querySelector('meta[name=user-email]');
    if (meta) identify(meta.content);
  })();
</script>
<% end %>

<!-- Google Consent Mode v2 — must run BEFORE gtag.js loads -->
<script>
  // Default: all consent denied. GA4/Ads still load but in restricted mode.
  // Google uses these signals for conversion modeling even without full consent.
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  gtag('consent', 'default', {
    'ad_storage':              'denied',
    'ad_user_data':            'denied',
    'ad_personalization':      'denied',
    'analytics_storage':       'denied',
    'functionality_storage':   'granted',   // shopping cart, wishlist — always needed
    'personalization_storage': 'granted',   // recently viewed, preferences — always needed
    'security_storage':        'granted',   // login, CSRF — always needed
    'wait_for_update':         500          // ms to wait for banner consent update before firing
  });

  // url_passthrough: preserves GCLID across redirects when ad_storage is denied
  // ads_data_redaction: redacts PII before sending to Google in denied state
  // Both must be set BEFORE gtag.js loads so they apply from the very first hit
  gtag('set', 'url_passthrough', true);
  gtag('set', 'ads_data_redaction', true);

  // If user already consented on a previous visit — upgrade immediately
  // Reads from cookie_consent_v2 cookie (set by _cookie_banner.html.erb)
  (function() {
    try {
      var match = document.cookie.match('(?:^|;)\\s*cookie_consent_v2=([^;]+)');
      if (!match) return;
      var c = JSON.parse(decodeURIComponent(match[1]));
      if (!c || !c.version) return;
      var state = {
        'ad_storage':              c.marketing       ? 'granted' : 'denied',
        'ad_user_data':            c.marketing       ? 'granted' : 'denied',
        'ad_personalization':      c.marketing       ? 'granted' : 'denied',
        'analytics_storage':       c.analytics       ? 'granted' : 'denied',
        'functionality_storage':   c.personalization ? 'granted' : 'denied',
        'personalization_storage': c.personalization ? 'granted' : 'denied'
      };
      gtag('consent', 'update', state);
      // Debug helper: add ?consent_debug=1 to URL to see consent state in console
      if (window.location.search.indexOf('consent_debug') !== -1) {
        console.log('[Consent] Restored from cookie:', state);
      }
    } catch(e) {}
  })();
</script>

<!-- Google Tag Manager — routes to GA4 + Google Ads -->
<!-- Loads AFTER Consent Mode v2 defaults are set — runs in restricted mode until consent granted -->
<% gtm_id  = ENV.fetch('GOOGLE_TAG_MANAGER_ID',    'GT-K54MS7QS') %>
<% ga4_id  = ENV.fetch('GA4_MEASUREMENT_ID',       'G-MLSPRGVMGD') %>
<% gads_id = ENV.fetch('GOOGLE_ADS_CONVERSION_ID', 'AW-11446870184') %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= gtm_id %>"></script>
<script>
  gtag('js', new Date());

  // Read consent cookie synchronously so returning users get correct signal
  // state on the very first config call — before any event fires.
  (function() {
    try {
      var m = document.cookie.match('(?:^|;)\\s*cookie_consent_v2=([^;]+)');
      var c = m ? JSON.parse(decodeURIComponent(m[1])) : null;
      var marketing = !!(c && c.version >= 2 && c.marketing);

      // GTM container
      gtag('config', '<%= gtm_id %>', {
        'allow_google_signals': marketing
      });
      // GA4 — personalization signals follow marketing consent
      gtag('config', '<%= ga4_id %>', {
        'allow_google_signals': marketing,
        'allow_ad_personalization_signals': marketing,
        'allow_enhanced_conversions': true
      });
      // Google Ads — same marketing consent gate
      gtag('config', '<%= gads_id %>', {
        'allow_google_signals': marketing,
        'allow_ad_personalization_signals': marketing,
        'allow_enhanced_conversions': true
      });
    } catch(e) {
      // Fallback: safe defaults (already set by GCM default block above)
      gtag('config', '<%= gtm_id %>');
      gtag('config', '<%= ga4_id %>');
      gtag('config', '<%= gads_id %>');
    }
  })();

  // url_passthrough and ads_data_redaction are set BEFORE gtag.js loads (above).
  // No need to repeat them here — they're already queued in dataLayer.
</script>


<!-- Hotjar — loaded only after analytics consent via cookieConsentUpdate event -->
<script>
(function() {
  function loadHotjar(hjid) {
    if (window._hjLoaded) return;
    window._hjLoaded = true;
    (function(h,o,t,j,a,r){
      h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
      h._hjSettings={hjid:hjid,hjsv:6};
      a=o.getElementsByTagName('head')[0];
      r=o.createElement('script');r.async=1;
      r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
      a.appendChild(r);
    })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
  }

  // Load Hotjar immediately if analytics already consented on previous visit
  var HJ_ID = parseInt('<%= ENV.fetch('HOTJAR_ID', '5062304') %>', 10);
  try {
    var match = document.cookie.match('(?:^|;)\\s*cookie_consent_v2=([^;]+)');
    if (match) {
      var c = JSON.parse(decodeURIComponent(match[1]));
      if (c && c.analytics) loadHotjar(HJ_ID);
    }
  } catch(e) {}

  // Load Hotjar when user consents during this session
  window.addEventListener('cookieConsentUpdate', function(e) {
    if (e.detail && e.detail.analytics) loadHotjar(HJ_ID);
  });
})();
</script>

<!-- GA4 add_to_cart event — fires directly via gtag on successful Turbo form submissions -->
<script>
(function() {
  var _pending = null;

  // Capture item data just before the add-to-cart form is submitted
  document.addEventListener('turbo:submit-start', function(e) {
    var form = e.target;
    if (form.dataset.gaEvent !== 'add_to_cart') return;
    var qty = form.querySelector('[name="quantity"]');
    _pending = {
      item_id:    form.dataset.gaItemId    || '',
      item_name:  form.dataset.gaItemName  || '',
      item_brand: form.dataset.gaItemBrand || '',
      price:      parseFloat(form.dataset.gaPrice || 0),
      quantity:   parseInt(qty ? qty.value : 1, 10) || 1
    };
  });

  // Fire directly via gtag on success
  document.addEventListener('turbo:submit-end', function(e) {
    var form = e.target;
    if (form.dataset.gaEvent !== 'add_to_cart') { _pending = null; return; }
    if (!e.detail.success)                       { _pending = null; return; }
    var d = _pending;
    _pending = null;
    if (!d || typeof gtag !== 'function') return;
    // Read currency from meta tag (set per-request) — avoids hardcoding 'EUR'
    var currency = document.querySelector('meta[name="cart-currency"]');
    gtag('event', 'add_to_cart', {
      currency: currency ? currency.content : 'EUR',
      value:    d.price * d.quantity,
      items: [{
        item_id:    d.item_id,
        item_name:  d.item_name,
        item_brand: d.item_brand,
        price:      d.price,
        quantity:   d.quantity
      }]
    });
  });
})();
</script>

