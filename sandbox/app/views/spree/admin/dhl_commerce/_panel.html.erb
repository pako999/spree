<%
  dhl_meta     = order.private_metadata || {}
  dhl_order_id = dhl_meta["dhl_order_id"]
  dhl_pushed   = dhl_meta["dhl_pushed_at"]
  already_sent = dhl_order_id.present? && dhl_order_id != "pending"
  pending      = dhl_order_id == "pending"

  saved_weight = dhl_meta["dhl_weight_kg"]
  saved_length = dhl_meta["dhl_length_cm"]
  saved_width  = dhl_meta["dhl_width_cm"]
  saved_height = dhl_meta["dhl_height_cm"]

  est_weight = order.line_items.sum { |li| (li.variant.weight.to_f.nonzero? || 0.5) * li.quantity }.round(2)
%>

<div id="dhl-commerce-panel" style="background:#fff;border:1.5px solid #f0b800;border-radius:10px;padding:20px 24px;margin-top:24px;">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <%# DHL logo SVG %>
    <svg width="52" height="22" viewBox="0 0 52 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="52" height="22" rx="3" fill="#FFCC00"/>
      <text x="5" y="15" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#D40511">DHL</text>
    </svg>
    <h4 style="margin:0;font-size:1rem;font-weight:700;color:#1a1a1a;">DHL Express Commerce</h4>
    <% if already_sent %>
      <span style="background:#dcfce7;color:#15803d;font-size:0.75rem;font-weight:700;padding:2px 10px;border-radius:99px;">&#10003; Sent to DHL</span>
    <% elsif pending %>
      <span style="background:#fef9c3;color:#92400e;font-size:0.75rem;font-weight:700;padding:2px 10px;border-radius:99px;">&#8987; Pending...</span>
    <% end %>
  </div>

  <% if already_sent %>
    <table style="font-size:0.85rem;border-collapse:collapse;margin-bottom:14px;">
      <tr>
        <td style="color:#6b7280;padding-right:16px;padding-bottom:4px;">DHL Order ID:</td>
        <td style="font-weight:600;"><%= dhl_order_id %></td>
      </tr>
      <tr>
        <td style="color:#6b7280;padding-right:16px;padding-bottom:4px;">Pushed at:</td>
        <td><%= Time.parse(dhl_pushed).strftime("%d.%m.%Y %H:%M") rescue dhl_pushed %></td>
      </tr>
      <% if saved_weight.present? %>
      <tr>
        <td style="color:#6b7280;padding-right:16px;">Package:</td>
        <td><%= saved_weight %> kg &nbsp;&bull;&nbsp; <%= saved_length %>&times;<%= saved_width %>&times;<%= saved_height %> cm</td>
      </tr>
      <% end %>
    </table>

    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <%= link_to "&#128279; Open in DHL Commerce",
            "https://app2.dhlexpresscommerce.com/orders",
            target: "_blank",
            style: "background:#FFCC00;color:#1a1a1a;font-weight:700;font-size:0.8125rem;padding:8px 16px;border-radius:6px;text-decoration:none;" %>

      <%= link_to "&#8617; Re-push (reset)",
            reset_admin_dhl_commerce_path(order_number: order.number),
            data: { turbo_method: :post, turbo_confirm: "Clear DHL status and re-push this order?" },
            style: "background:#f3f4f6;color:#374151;font-size:0.8125rem;padding:8px 16px;border-radius:6px;text-decoration:none;border:1px solid #d1d5db;" %>
    </div>

  <% else %>
    <%= form_with url: push_admin_dhl_commerce_path(order_number: order.number),
                  method: :post, local: true do |f| %>

      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px;">
        <div>
          <label style="display:block;font-size:0.7rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Weight (kg)</label>
          <%= f.text_field :weight_kg, value: saved_weight || est_weight,
                placeholder: est_weight.to_s,
                style: "width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px 10px;font-size:0.875rem;" %>
          <div style="font-size:0.68rem;color:#9ca3af;margin-top:2px;">Est. <%= est_weight %> kg</div>
        </div>
        <div>
          <label style="display:block;font-size:0.7rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Length (cm)</label>
          <%= f.text_field :length_cm, value: saved_length || "40",
                style: "width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px 10px;font-size:0.875rem;" %>
        </div>
        <div>
          <label style="display:block;font-size:0.7rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Width (cm)</label>
          <%= f.text_field :width_cm, value: saved_width || "30",
                style: "width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px 10px;font-size:0.875rem;" %>
        </div>
        <div>
          <label style="display:block;font-size:0.7rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Height (cm)</label>
          <%= f.text_field :height_cm, value: saved_height || "20",
                style: "width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px 10px;font-size:0.875rem;" %>
        </div>
      </div>

      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <%= f.submit "&#128230; Push to DHL Express Commerce",
              style: "background:#D40511;color:#fff;font-weight:700;font-size:0.8125rem;padding:9px 20px;border-radius:6px;border:none;cursor:pointer;" %>

        <%= link_to "&#128279; Open DHL Commerce",
              "https://app2.dhlexpresscommerce.com/orders",
              target: "_blank",
              style: "background:#f3f4f6;color:#374151;font-size:0.8125rem;padding:9px 16px;border-radius:6px;text-decoration:none;border:1px solid #d1d5db;" %>
      </div>
    <% end %>
  <% end %>
</div>
