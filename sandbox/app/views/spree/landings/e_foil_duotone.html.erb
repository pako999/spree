<%# ── VIDEO PLAYER JS ── %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var poster = document.getElementById('lp-yt-poster');
  var playBtn = document.getElementById('lp-yt-play');
  var wrapper = document.getElementById('lp-yt-wrapper');
  function loadVideo() {
    if (!wrapper || wrapper.dataset.loaded) return;
    wrapper.dataset.loaded = '1';
    wrapper.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/Wj6xwO_FDqU?autoplay=1&rel=0" title="Duotone Foil Assist 2026" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;border-radius:12px;"></iframe>';
    typeof gtag==='function'&&gtag('event','select_promotion',{promotion_name:'efoil_video',creative_slot:'video_play'});
  }
  if (poster) poster.addEventListener('click', loadVideo);
  if (playBtn) playBtn.addEventListener('click', loadVideo);
});
</script>

<%# ── SCOPED STYLES ── %>
<style>
/* ============================================================
   .lp-efoil — Duotone E-Foil landing page
   Brand: cyan #00C2FF / teal #0FE0C4 / dark #0B0E14 / #111620
   Fonts: Barlow Condensed (display) + Barlow (body)
   ============================================================ */
.lp-efoil {
  --lp-cyan: #00C2FF;
  --lp-teal: #0FE0C4;
  --lp-dark: #0B0E14;
  --lp-dark2: #111620;
  --lp-dark3: #1A1F2E;
  --lp-light: #E8EDF5;
  --lp-white: #ffffff;
  --lp-muted: #8A95A9;
  --lp-font-display: 'Barlow Condensed', Impact, sans-serif;
  --lp-font-body: 'Barlow', -apple-system, sans-serif;
  --lp-radius: 12px;
  --lp-max: 1180px;
  font-family: var(--lp-font-body);
  color: var(--lp-light);
  background: var(--lp-dark);
}

/* ── Container ── */
.lp-container {
  max-width: var(--lp-max);
  margin: 0 auto;
  padding: 0 20px;
}

/* ── Sections ── */
.lp-section {
  padding: 80px 0;
}
.lp-section--dark {
  background: var(--lp-dark2);
}
.lp-section__title {
  font-family: var(--lp-font-display);
  font-weight: 700;
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  text-align: center;
  margin-bottom: 12px;
  color: var(--lp-white);
}
.lp-section__sub {
  text-align: center;
  color: var(--lp-muted);
  font-size: 1.05rem;
  max-width: 680px;
  margin: 0 auto 48px;
  line-height: 1.6;
}
.lp-section__note {
  text-align: center;
  color: var(--lp-muted);
  font-size: 0.875rem;
  margin-top: 24px;
}

/* ── Chip ── */
.lp-chip {
  display: inline-block;
  padding: 6px 18px;
  border-radius: 100px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: rgba(0,194,255,0.15);
  color: var(--lp-cyan);
  border: 1px solid rgba(0,194,255,0.3);
  margin-bottom: 24px;
}

/* ── Buttons ── */
.lp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 32px;
  border-radius: 8px;
  font-family: var(--lp-font-body);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.25s ease;
  border: 2px solid transparent;
}
.lp-btn--primary {
  background: linear-gradient(135deg, var(--lp-cyan), var(--lp-teal));
  color: var(--lp-dark);
}
.lp-btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,194,255,0.35);
}
.lp-btn--ghost {
  background: transparent;
  color: var(--lp-white);
  border-color: rgba(255,255,255,0.3);
}
.lp-btn--ghost:hover {
  border-color: var(--lp-cyan);
  color: var(--lp-cyan);
}
.lp-btn--outline {
  background: transparent;
  color: var(--lp-cyan);
  border-color: var(--lp-cyan);
}
.lp-btn--outline:hover {
  background: var(--lp-cyan);
  color: var(--lp-dark);
}
.lp-btn--lg {
  padding: 16px 40px;
  font-size: 1.05rem;
}
.lp-link { color: var(--lp-cyan); text-decoration: underline; }

/* ── A. HERO ── */
.lp-hero {
  position: relative;
  min-height: 85vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(11,14,20,0.3) 0%, rgba(11,14,20,0.85) 100%),
    url('https://img.youtube.com/vi/Wj6xwO_FDqU/maxresdefault.jpg') center/cover no-repeat;
}
.lp-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(11,14,20,0.2) 0%,
    rgba(11,14,20,0.7) 60%,
    var(--lp-dark) 100%);
  z-index: 1;
}
.lp-hero__content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 120px 20px 80px;
}
.lp-hero__h1 {
  font-family: var(--lp-font-display);
  font-weight: 900;
  font-size: clamp(2.2rem, 6vw, 4rem);
  text-transform: uppercase;
  letter-spacing: 0.01em;
  line-height: 1.1;
  margin-bottom: 20px;
  color: var(--lp-white);
}
.lp-hero__h1 br { display: block; }
.lp-hero__sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  line-height: 1.65;
  color: rgba(255,255,255,0.8);
  margin-bottom: 32px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}
.lp-hero__ctas {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 40px;
}
.lp-trust {
  display: flex;
  gap: 24px;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
}
.lp-trust span { white-space: nowrap; }

/* ── B. VIDEO ── */
.lp-video__wrapper {
  position: relative;
  padding-bottom: 56.25%;
  border-radius: var(--lp-radius);
  overflow: hidden;
  cursor: pointer;
  background: var(--lp-dark3);
}
.lp-video__poster {
  position: absolute;
  inset: 0;
  width: 100%;
