<%# ── SEO / social meta (injected into <head> by the storefront head partial) ── %>
<% page_title = "Duotone E-Foil — Electric Foiling, Redefined | Surf Store" %>
<% page_desc  = "Glide above the water on a Duotone E-Foil. Silent electric power, effortless take-off, and ride-anywhere freedom — flat water, no waves, no wind needed. Official Duotone dealer, EU shipping & 2-year warranty." %>
<% canonical  = spree.landing_page_url(slug: 'e-foil-duotone', host: current_store.url) rescue nil %>

<% content_for :title, page_title %>
<% content_for :head do %>
  <meta name="description" content="<%= page_desc %>">
  <% if canonical %><link rel="canonical" href="<%= canonical %>"><% end %>

  <meta property="og:type"        content="website">
  <meta property="og:title"       content="<%= page_title %>">
  <meta property="og:description" content="<%= page_desc %>">
  <% if canonical %><meta property="og:url" content="<%= canonical %>"><% end %>
  <meta property="og:site_name"   content="Surf Store">
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="<%= page_title %>">
  <meta name="twitter:description" content="<%= page_desc %>">

  <script type="application/ld+json">
  <%= {
    "@context" => "https://schema.org",
    "@type"    => "FAQPage",
    "mainEntity" => [
      { "@type" => "Question", "name" => "Do I need waves or wind to ride an E-Foil?",
        "acceptedAnswer" => { "@type" => "Answer", "text" => "No. An electric foil has its own silent motor, so you can ride on completely flat water — lakes, calm sea, anywhere. No waves, no wind, no boat needed." } },
      { "@type" => "Question", "name" => "Is the Duotone E-Foil hard to learn?",
        "acceptedAnswer" => { "@type" => "Answer", "text" => "Most riders are foiling within their first one to two sessions. You start on your knees at low power, then progress to standing as your balance develops. A wireless hand controller manages the speed for you." } },
      { "@type" => "Question", "name" => "How long does the battery last?",
        "acceptedAnswer" => { "@type" => "Answer", "text" => "Ride time depends on rider weight, speed and conditions, with typical sessions running well over an hour. Batteries are swappable, so a spare lets you ride all day." } },
      { "@type" => "Question", "name" => "Do you ship across Europe and offer a warranty?",
        "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. We are an official Duotone dealer with fast EU-wide shipping, a 2-year warranty and expert support before and after your purchase." } }
    ]
  }.to_json.html_safe %>
  </script>
<% end %>

<%# ─────────────────────────────────────────────────────────────────────── %>
<section class="lp-efoil">
  <style>
    .lp-efoil{--lp-bg:#0B0E14;--lp-bg2:#111620;--lp-surface:#161C28;--lp-surface2:#1E2533;--lp-border:rgba(255,255,255,.09);--lp-accent:#00C2FF;--lp-accent2:#0FE0C4;--lp-gold:#F5A623;--lp-text:#EAF0F7;--lp-muted:#8A97AB;background:var(--lp-bg);color:var(--lp-text);font-family:'Barlow',system-ui,sans-serif;overflow:hidden}
    .lp-efoil *{box-sizing:border-box}
    .lp-wrap{max-width:1180px;margin:0 auto;padding:0 20px}
    .lp-efoil h1,.lp-efoil h2,.lp-efoil h3,.lp-efoil .lp-head{font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;letter-spacing:-.01em;line-height:1.05}
    .lp-efoil p{color:var(--lp-muted);line-height:1.65;margin:0 0 1rem}

    /* HERO */
    .lp-hero{position:relative;padding:84px 0 72px;background:radial-gradient(1200px 600px at 75% -10%,rgba(0,194,255,.22),transparent 60%),radial-gradient(900px 500px at 0% 110%,rgba(15,224,196,.14),transparent 55%),linear-gradient(180deg,var(--lp-bg) 0%,var(--lp-bg2) 100%)}
    .lp-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
    .lp-eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--lp-accent);border:1px solid rgba(0,194,255,.35);background:rgba(0,194,255,.08);padding:6px 14px;border-radius:40px;margin-bottom:20px}
    .lp-hero h1{font-size:clamp(40px,6vw,72px);color:#fff;margin:0 0 18px}
    .lp-hero h1 .grad{background:linear-gradient(90deg,var(--lp-accent),var(--lp-accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
    .lp-hero .lead{font-size:clamp(17px,2vw,20px);max-width:560px}
    .lp-cta-row{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 22px}
    .lp-btn{display:inline-flex;align-items:center;gap:10px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:17px;letter-spacing:.03em;text-transform:uppercase;padding:15px 30px;border-radius:8px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;cursor:pointer;border:0}
    .lp-btn-primary{background:linear-gradient(90deg,var(--lp-accent),var(--lp-accent2));color:#04141b;box-shadow:0 10px 30px -8px rgba(0,194,255,.6)}
    .lp-btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 38px -8px rgba(0,194,255,.7)}
    .lp-btn-ghost{background:transparent;color:#fff;border:1px solid var(--lp-border)}
    .lp-btn-ghost:hover{border-color:var(--lp-accent);color:var(--lp-accent)}
    .lp-hero-trust{display:flex;flex-wrap:wrap;gap:18px 26px;margin-top:8px;font-size:14px;color:var(--lp-muted)}
    .lp-hero-trust span{display:inline-flex;align-items:center;gap:8px}
    .lp-hero-trust svg{width:18px;height:18px;color:var(--lp-accent2);flex-shrink:0}
    .lp-hero-visual{position:relative;border-radius:18px;min-height:380px;background:linear-gradient(150deg,#0d2330,#0a1622);border:1px solid var(--lp-border);overflow:hidden;display:flex;align-items:center;justify-content:center}
    .lp-hero-visual::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 300px at 50% 0%,rgba(0,194,255,.28),transparent 65%)}
    .lp-hero-visual .lp-board{position:relative;text-align:center;padding:30px}
    .lp-hero-visual .lp-board .ring{width:150px;height:150px;margin:0 auto 18px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(0,194,255,.08);border:1px solid rgba(0,194,255,.3);box-shadow:0 0 0 14px rgba(0,194,255,.04)}
    .lp-hero-visual .lp-board .ring svg{width:74px;height:74px;color:var(--lp-accent)}
    .lp-hero-visual .lp-board .big{font-family:'Barlow Condensed',sans-serif;font-size:30px;font-weight:700;color:#fff}
    .lp-hero-visual .lp-board .sm{font-size:14px;color:var(--lp-muted)}

    /* GENERIC SECTION */
    .lp-sec{padding:72px 0}
    .lp-sec.alt{background:var(--lp-bg2)}
    .lp-sec-head{text-align:center;max-width:680px;margin:0 auto 44px}
    .lp-kicker{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--lp-accent)}
    .lp-sec-head h2{font-size:clamp(30px,4vw,46px);color:#fff;margin:10px 0 14px}

    /* TRUST BAR */
    .lp-trustbar{background:var(--lp-surface);border-top:1px solid var(--lp-border);border-bottom:1px solid var(--lp-border)}
    .lp-trustbar .lp-wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:1px}
    .lp-trust-item{display:flex;align-items:center;gap:12px;padding:22px 16px}
    .lp-trust-item svg{width:28px;height:28px;color:var(--lp-accent);flex-shrink:0}
    .lp-trust-item b{display:block;color:#fff;font-size:15px;font-family:'Barlow Condensed',sans-serif;letter-spacing:.02em}
    .lp-trust-item small{color:var(--lp-muted);font-size:13px}

    /* FEATURE CARDS */
    .lp-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .lp-card{background:var(--lp-surface);border:1px solid var(--lp-border);border-radius:14px;padding:30px 26px;transition:transform .18s ease,border-color .18s ease}
    .lp-card:hover{transform:translateY(-4px);border-color:rgba(0,194,255,.4)}
    .lp-card .ic{width:54px;height:54px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(0,194,255,.1);margin-bottom:18px}
    .lp-card .ic svg{width:28px;height:28px;color:var(--lp-accent)}
    .lp-card h3{font-size:22px;color:#fff;margin:0 0 8px}
    .lp-card p{margin:0;font-size:15px}

    /* STATS STRIP */
    .lp-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--lp-border);border:1px solid var(--lp-border);border-radius:14px;overflow:hidden;margin-top:8px}
    .lp-stat{background:var(--lp-surface);padding:30px 18px;text-align:center}
    .lp-stat .v{font-family:'Barlow Condensed',sans-serif;font-size:40px;font-weight:700;color:var(--lp-accent);line-height:1}
    .lp-stat .l{margin-top:8px;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--lp-muted)}

    /* STEPS */
    .lp-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;counter-reset:step}
    .lp-step{position:relative;background:var(--lp-surface);border:1px solid var(--lp-border);border-radius:14px;padding:34px 26px 28px}
    .lp-step::before{counter-increment:step;content:counter(step);position:absolute;top:-18px;left:26px;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;color:#04141b;background:linear-gradient(90deg,var(--lp-accent),var(--lp-accent2))}
    .lp-step h3{font-size:20px;color:#fff;margin:8px 0}
    .lp-step p{margin:0;font-size:15px}

    /* PRODUCTS — theme cards are built for a light storefront, so place each on a light tile */
    .lp-products{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .lp-products .swiper-slide{background:#fff;border-radius:14px;padding:16px;color:#0B0E14;border:1px solid var(--lp-border)}
    .lp-products .product-card-title,.lp-products .pdp-price-current,.lp-products .product-card-price{color:#0B0E14}
    .lp-products .product-card-brand{color:#55617a}
    .lp-empty{text-align:center;padding:30px}

    /* FAQ */
    .lp-faq{max-width:820px;margin:0 auto}
    .lp-faq details{background:var(--lp-surface);border:1px solid var(--lp-border);border-radius:12px;margin-bottom:14px;overflow:hidden}
    .lp-faq summary{cursor:pointer;list-style:none;padding:20px 24px;font-family:'Barlow Condensed',sans-serif;font-size:19px;font-weight:600;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:16px}
    .lp-faq summary::-webkit-details-marker{display:none}
    .lp-faq summary::after{content:"+";font-size:26px;color:var(--lp-accent);transition:transform .2s ease;line-height:1}
    .lp-faq details[open] summary::after{transform:rotate(45deg)}
    .lp-faq details p{padding:0 24px 22px;margin:0;font-size:15px}

    /* FINAL CTA */
    .lp-final{position:relative;text-align:center;padding:84px 0;background:radial-gradient(900px 400px at 50% 0%,rgba(0,194,255,.22),transparent 60%),linear-gradient(180deg,var(--lp-bg2),var(--lp-bg))}
    .lp-final h2{font-size:clamp(32px,5vw,56px);color:#fff;margin:0 0 14px}
    .lp-final p{max-width:560px;margin:0 auto 28px;font-size:18px}

    @media(max-width:920px){
      .lp-hero-grid{grid-template-columns:1fr;gap:34px}
      .lp-hero-visual{min-height:300px;order:-1}
      .lp-grid-3,.lp-steps{grid-template-columns:1fr}
      .lp-trustbar .lp-wrap{grid-template-columns:repeat(2,1fr)}
      .lp-stats{grid-template-columns:repeat(2,1fr)}
      .lp-products{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:560px){
      .lp-products{grid-template-columns:1fr}
    }
  </style>

  <%# ── HERO ───────────────────────────────────────────────────────────── %>
  <div class="lp-hero">
    <div class="lp-wrap lp-hero-grid">
      <div>
        <span class="lp-eyebrow">
