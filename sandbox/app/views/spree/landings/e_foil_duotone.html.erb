<%# ── SEO ── %>
<% content_for :title, "Duotone E-Foil / Foil Assist — Electric Foiling | Surf Store" %>

<% content_for :head do %>
  <meta name="description" content="Duotone Foil Assist — the electric foil assist system. Motor integrated in the mast, batteries on your hips. 30–60 min runtime, airline-friendly batteries. Official EU dealer.">
  <link rel="canonical" href="https://www.surf-store.com/lp/e-foil-duotone">

  <%# Open Graph %>
  <meta property="og:type" content="product.group">
  <meta property="og:title" content="Duotone Foil Assist — Electric Foiling | Surf Store">
  <meta property="og:description" content="Power when you need it. Pure foiling when you don't. Duotone's electric foil assist with waist-mounted batteries and integrated motor mast.">
  <meta property="og:url" content="https://www.surf-store.com/lp/e-foil-duotone">
  <meta property="og:image" content="https://cdn.duotonesports.com/media/catalog/product/cache/foil_assist_hero.jpg">
  <meta property="og:site_name" content="Surf Store">

  <%# Twitter Card %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Duotone Foil Assist — Electric Foiling">
  <meta name="twitter:description" content="Power when you need it. Pure foiling when you don't.">

  <%# JSON-LD: BreadcrumbList %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.surf-store.com/" },
      { "@type": "ListItem", "position": 2, "name": "E-Foil", "item": "https://www.surf-store.com/t/categories/e-foil" },
      { "@type": "ListItem", "position": 3, "name": "Duotone Foil Assist", "item": "https://www.surf-store.com/lp/e-foil-duotone" }
    ]
  }
  </script>

  <%# JSON-LD: Product %>
  <% if @products.present? %>
    <% lowest = @products.flat_map { |p| p.master.prices.select { |pr| pr.currency == 'EUR' } }.compact.min_by(&:amount) %>
    <% if lowest %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Duotone Foil Assist",
      "brand": { "@type": "Brand", "name": "Duotone" },
      "description": "Electric foil assist system with integrated motor mast and waist-mounted batteries. 30-60 min runtime, airline-friendly.",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "EUR",
        "lowPrice": "<%= lowest.amount.to_f %>",
        "offerCount": "<%= @products.size %>",
        "availability": "https://schema.org/InStock",
        "url": "https://www.surf-store.com/lp/e-foil-duotone"
      }
    }
    </script>
    <% end %>
  <% end %>

  <%# JSON-LD: FAQPage %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is the Duotone Foil Assist an eFoil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. It's a Foil Assist — it provides power for take-offs and light-wind sessions but preserves the natural feel of traditional foiling. It's not designed for continuous motorised riding like a full eFoil."
        }
      },
      {
        "@type": "Question",
        "name": "How long does the battery last?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "30–60+ minutes per charge depending on rider weight, foil size, riding style, and conditions. Using the motor in short bursts provides the longest sessions."
        }
      },
      {
        "@type": "Question",
        "name": "Can I fly with the batteries?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Each battery is 159.6 Wh, designed to be under the 160 Wh airline limit. Always verify your specific airline's lithium battery policy before travelling."
        }
      },
      {
        "@type": "Question",
        "name": "Will it work with my existing foil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most likely yes. The system is compatible with boards using standard US foil tracks. You'll need a brand-specific fuselage adapter (sold separately). Compatible brands include Duotone, Armstrong, AFS, Axis, Code Foils, F-One, North, SAB, Lift, KT, and Gong."
        }
      },
      {
        "@type": "Question",
        "name": "What's the difference between Standard and Cruise?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard (AL / D/LAB) has the motor at the top of the mast — ideal as a launch-assist for waves and downwind. Cruise has the motor at the bottom with a prop guard — designed for flatwater cruising and learning."
        }
      },
      {
        "@type": "Question",
        "name": "Do you ship across the EU?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Surf Store ships to all EU countries. Lithium batteries are shipped via ground transport in compliance with IATA DGR regulations."
        }
      }
    ]
  }
  </script>
<% end %>

