  <%# ═══════════════════════════════════════════════════════════
      G. HOW IT WORKS
  ═══════════════════════════════════════════════════════════ %>
  <section class="lp-section" aria-label="How it works">
    <div class="lp-container">
      <h2 class="lp-section__title">How it works</h2>
      <div class="lp-steps">
        <div class="lp-step">
          <div class="lp-step__num">1</div>
          <h3 class="lp-step__title">Power up</h3>
          <p class="lp-step__text">Clip the eHarness around your waist, connect the cable to the mast, and double-click the Watch Ring Remote to activate. The system is ready in seconds.</p>
        </div>
        <div class="lp-step">
          <div class="lp-step__num">2</div>
          <h3 class="lp-step__title">Squeeze &amp; launch</h3>
          <p class="lp-step__text">Press the ring on your finger to engage the motor. The folding propeller opens and provides instant thrust — you're on the foil in moments, even in zero wind or flat water.</p>
        </div>
        <div class="lp-step">
          <div class="lp-step__num">3</div>
          <h3 class="lp-step__title">Rise &amp; glide</h3>
          <p class="lp-step__text">Release the ring and the propeller folds flat. You're now riding pure foil — no motor drag, no extra weight on the board. Use the assist whenever you need a boost.</p>
        </div>
      </div>
    </div>
  </section>

